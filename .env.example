# Required. A free TMDB key. Either the classic v3 "API Key" or the long v4
# "API Read Access Token" works - the addon auto-detects which one you pasted.
# Get it at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional. Port to listen on.
PORT=7000

# Optional. Metadata language for titles/overviews.
TMDB_LANG=en-US

# Optional overrides. Defaults are Cartoon Network.
#   CN_NETWORK_ID -> TMDB TV network id (56 = Cartoon Network) drives the series row
#   CN_COMPANY_ID -> TMDB company id (7899 = Cartoon Network Studios) drives movies
CN_NETWORK_ID=56
CN_COMPANY_ID=7899
